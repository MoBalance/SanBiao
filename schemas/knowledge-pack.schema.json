{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/MoBalance/SanBiao/main/schemas/knowledge-pack.schema.json",
  "title": "SanBiao knowledge challenge pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "channel", "publishedAt", "targets", "challenges"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/identifier" },
    "version": { "$ref": "#/$defs/identifier" },
    "channel": { "$ref": "#/$defs/identifier" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/target" }
    },
    "challenges": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/challenge" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9._/+\\-]+$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "model"],
      "properties": {
        "protocol": { "enum": ["anthropic", "openai", "gemini"] },
        "provider": { "$ref": "#/$defs/identifier" },
        "model": { "$ref": "#/$defs/identifier" }
      }
    },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt", "expectedTerms"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "expectedTerms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "uncertaintyTerms": {
          "type": "array",
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      }
    }
  }
}
